---
import GameEntry from "@/components/game/GameEntry";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="BoulderGame" showConfigWarnings={false}>
  <GameEntry client:only="react">
    <main slot="fallback" class="min-h-screen bg-[#10140f] text-[#f5e7c8]">
      <section class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 py-5 sm:px-6 lg:px-8">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b-4 border-[#374f42] pb-4">
          <div>
            <p class="font-mono text-xs tracking-[0.18em] text-[#79eada] uppercase">Cave broadcast</p>
            <h1 class="font-mono text-4xl leading-none font-black tracking-normal text-[#f5e7c8] sm:text-6xl">
              BoulderGame
            </h1>
          </div>
          <div class="border-4 border-[#3f3124] bg-[#191d17] px-4 py-3 text-right font-mono shadow-[6px_6px_0_#070806]">
            <p class="text-xs tracking-[0.16em] text-[#9fb58f] uppercase">Level 01</p>
            <p class="text-2xl font-black text-[#f3b63f]">READY</p>
          </div>
        </header>
      </section>
    </main>
  </GameEntry>
</Layout>
